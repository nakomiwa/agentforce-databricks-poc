<!--
  使わなくなった資材の削除。

  【削除の順序】
    GenAiFunction → LightningTypeBundle → LightningComponentBundle → ApexClass
  参照している側から消す。逆順だと
  「このApex クラスは、Salesforce の他の場所で参照されています」で失敗する。

  【済】2026-09-21 第1回
        旧③: Ask_Sales_Agent / DatabricksAgentService
  【済】2026-09-21 第2回
        Get_Sales_Summary_V2 / Get_Sales_Report_Html
        salesSummaryV2 / salesReportHtml
        salesReportHtmlRenderer / DatabricksReportService

  【今回】第2回で残ったもの。
        リポジトリには無いが組織に残っていた v1 世代の資材
        （salesSummary / Get_Sales_Summary）が
        DatabricksSalesService と salesSummaryRenderer を掴んでいたため、
        そちらを先に消す。
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>Get_Sales_Summary</members>
        <name>GenAiFunction</name>
    </types>
    <types>
        <members>salesSummary</members>
        <name>LightningTypeBundle</name>
    </types>
    <types>
        <members>salesSummaryRenderer</members>
        <name>LightningComponentBundle</name>
    </types>
    <types>
        <members>DatabricksSalesService</members>
        <name>ApexClass</name>
    </types>
    <version>66.0</version>
</Package>
